# MANISK OS Production Configuration
# Copy to .env and fill with secure values
# NEVER commit .env with real secrets

# Core
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/manisk.db
UPLOAD_PATH=./data/uploads
LOG_LEVEL=info

# Security - MUST be set to strong random values in production (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars-secure
ENCRYPTION_KEY=change-me-32-char-key-for-aes-256!!
COOKIE_SECURE=true
CORS_ORIGIN=https://your-domain.com
ENFORCE_SECURE_CONFIG=false

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_CHAT_MAX=60
RATE_LIMIT_SEARCH_MAX=100
RATE_LIMIT_RESEARCH_MAX=30
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_TASK_MAX=30
RATE_LIMIT_SYSTEM_MAX=100

# AI Providers - Optional, but required for enhanced intelligence
# If missing, system uses local fallback and marks as REQUIRES CONFIGURATION
# Nemotron is first-class provider (NVIDIA NIM, OpenAI-compatible)
NEMOTRON_API_KEY=
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Email Integration - REQUIRES CONFIGURATION for sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# Optional Integrations - OAuth and Hardware
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SMARTTHINGS_TOKEN=
HUE_BRIDGE_IP=
HUE_USER=
NEST_OAUTH=

# Session
SESSION_EXPIRY_DAYS=7
